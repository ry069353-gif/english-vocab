# ============================================
# Set these in Vercel dashboard: Project → Settings → Environment Variables
# (Don't put real secrets in this file or commit a filled-in .env to git)
# ============================================

# From your Google Cloud OAuth Client ID
GOOGLE_CLIENT_ID=720582602063-ot2n7qh268t2hfp1qlmsloq1rbfb7pbj.apps.googleusercontent.com

# Random secret used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-STRING
JWT_EXPIRES_IN=8h

# ===== ADMIN LOGIN =====
# This is the username/password you will type into admin.html to sign in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!

# ===== TURSO DATABASE =====
# From your Turso dashboard: turso db show <db-name> --url
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# From: turso db tokens create <db-name>
TURSO_AUTH_TOKEN=your-turso-auth-token

# Comma-separated list of frontend origins allowed to call this API.
# If frontend + backend are on the SAME Vercel project/domain, this can be left empty.
ALLOWED_ORIGINS=
