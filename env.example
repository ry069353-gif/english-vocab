# ============================================
# COPY THIS FILE TO ".env" AND FILL IN YOUR VALUES
# Never commit the real ".env" file to git!
# ============================================

NODE_ENV=production
PORT=3000

# Google OAuth Client ID (same one used in google-config.js on the frontend)
GOOGLE_CLIENT_ID=720582602063-ot2n7qh268t2hfp1qlmsloq1rbfb7pbj.apps.googleusercontent.com

# Random secret used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-STRING

# How long an admin session stays logged in
JWT_EXPIRES_IN=8h

# ===== ADMIN LOGIN =====
# This is the username/password you will type into admin.html to sign in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!

# Where the SQLite database file is stored
DB_PATH=./data/english-vocab.db

# Comma-separated list of frontend origins allowed to call this API
# Example: https://your-site.com,http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
